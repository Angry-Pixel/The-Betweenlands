{
  "multipart": [
    {
      "apply": {
        "model": "thebetweenlands:block/purified_dug_swamp_grass"
      }
    },
    {
      "apply": {
        "model": "thebetweenlands:block/dug_swamp_grass_top"
      },
      "when": {
        "composted": "false"
      }
    },
    {
      "apply": {
        "model": "thebetweenlands:block/dug_swamp_grass_top_composted"
      },
      "when": {
        "composted": "true"
      }
    }
  ]
}