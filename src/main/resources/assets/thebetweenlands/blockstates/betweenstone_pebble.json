{
	"multipart": [
		{
			"apply": { "model": "thebetweenlands:block/pebble_pile_1" },
			"when": { "pebbles": "1" }
		},
		{
			"apply": { "model": "thebetweenlands:block/pebble_pile_2" },
			"when": { "pebbles": "2" }
		},
		{
			"apply": { "model": "thebetweenlands:block/pebble_pile_3" },
			"when": { "pebbles": "3" }
		},
		{
			"apply": { "model": "thebetweenlands:block/pebble_pile_4" },
			"when": { "pebbles": "4" }
		},
		{
			"apply": { "model": "thebetweenlands:block/pebble_pile_plants" },
			"when": { "OR": [
				{ "plant": "true" },
				{ "water_type": "water|swamp_water" }
			]}
		}
	]
}